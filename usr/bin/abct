#!/bin/bash
set -e # Exit immediately if any step fails

# Help menu
if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Timber Compiler Pipeline Tool"
    echo "Usage: abct <input.tmb> -o <output_executable> [--extra-compile-args='args']"
    exit 0
fi

INPUT_FILE=""
OUTPUT_EXE="a.out"
EXTRA_ARGS=""
C_style=""
_EXTRA_FLAGS=""
_COMPILER_FLAGS="-I . -std=c++20"

module=0

# Parse flags manually to separate compiler inputs from backend engine passes
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)
            OUTPUT_EXE="$2"
            shift 2
            ;;
        --extra-compile-args=*)
            EXTRA_ARGS="${1#*=}"
            shift 1
            ;;
        --C-style)
            C_style="--C-style"
            shift 1
            ;;
        --as-module | -m)
            module=1
            _EXTRA_FLAGS="$_EXTRA_FLAGS -m $2"
            shift 2
            ;;
        *)
            if [ -z "$INPUT_FILE" ]; then
                INPUT_FILE="$1"
                
            else
                echo "Error: Multiple input files detected ($INPUT_FILE and $1)"
                exit 1
            fi
            shift 1
            ;;
    esac
done

if [ -z "$INPUT_FILE" ]; then
    echo "Error: No input file specified."
    exit 1
fi

# 1. Compiler Selection Matrix (Prioritize clang++ over g++)
if command -v clang++ >/dev/null 2>&1; then
    CXX="clang++"
elif command -v g++ >/dev/null 2>&1; then
    CXX="g++"
else
    echo "Error: Neither clang++ nor g++ was found on this system." >&2
    echo "Please install a working C++ compiler backend to use Timber." >&2
    exit 1
fi

# 2. Create a secure temporary workspace for the intermediate C++ code
TMP_CPP=$(mktemp /tmp/abct_XXXXXX.cpp)

# Step 1: Lower Timber source to C++ using our tmbCpp script asset
abcTCpp "$INPUT_FILE" -o "$TMP_CPP" $C_style $_EXTRA_FLAGS
# Trap exits to wipe out the temporary C++ residue file automatically from /tmp
trap 'rm -f "$TMP_CPP"' EXIT

if [ $module -eq 1 ]; then
    cp $TMP_CPP $OUTPUT_EXE
    exit 0
fi

# Fetch required compilation flags from the pkg-config setup
CXX_FLAGS=$(pkg-config --cflags abct 2>/dev/null || echo "-I/usr/include/abct")

# Step 2: Compile the temporary file using the selected backend engine
$CXX $CXX_FLAGS "$TMP_CPP" -o "$OUTPUT_EXE" $EXTRA_ARGS $_COMPILER_FLAGS

echo "Successfully built ($CXX) -> $OUTPUT_EXE"
