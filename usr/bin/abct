#!/usr/bin/env python3

import argparse
import platform
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def abct_config():
    """Return the include flag required by the AbcT installation."""
    if platform.system() == "Linux":
        return "-I/usr/include"

    include_dir = (Path(__file__).resolve().parent / "../include").resolve()
    return f"-I{include_dir}"

def abcTCpp(argv: list[str]) -> None:

    abct_lib = Path("/usr/lib/abct")

    if str(abct_lib) not in sys.path:
        sys.path.insert(0, str(abct_lib))

    from abct.compiler.cpp.compiler import main as cpp_compiler_main

    cpp_compiler_main(argv)

def find_compiler():
    """Prefer clang++, falling back to g++."""
    for compiler in ("clang++", "g++"):
        if shutil.which(compiler):
            return compiler

    print(
        "Error: Neither clang++ nor g++ was found on this system.",
        file=sys.stderr,
    )
    print(
        "Please install a working C++ compiler backend to use AbcT.",
        file=sys.stderr,
    )
    sys.exit(1)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="abct",
        description="Timber Compiler Pipeline Tool",
    )

    parser.add_argument(
        "input",
        metavar="input.ab",
        help="AbcT source file",
    )

    parser.add_argument(
        "-o",
        "--output",
        default="a.out",
        help="output executable (default: a.out)",
    )

    parser.add_argument(
        "--extra-compile-args",
        default="",
        help="additional arguments passed to the C++ compiler",
    )

    parser.add_argument(
        "--as-module",
        metavar="NAME",
        help="emit a C++ module instead of compiling an executable",
    )

    parser.add_argument(
        "-m",
        dest="module",
        metavar="NAME",
        help="emit a C++ module instead of compiling an executable",
    )

    return parser


def run_command(command):
    try:
        subprocess.run(command, check=True)
    except FileNotFoundError:
        print(f"Error: command not found: {command[0]}", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as exc:
        sys.exit(exc.returncode)


def main():
    parser = build_parser()
    args = parser.parse_args()

    input_file = Path(args.input)

    if not input_file.exists():
        print(
            f"Error: Input file '{input_file}' not found.",
            file=sys.stderr,
        )
        sys.exit(1)

    if not input_file.is_file():
        print(
            f"Error: Input path '{input_file}' is not a file.",
            file=sys.stderr,
        )
        sys.exit(1)

    if input_file.suffix != ".ab":
        print(
            f"Error: Input file must have a .ab extension: '{input_file}'",
            file=sys.stderr,
        )
        sys.exit(1)

    # --as-module and -m are aliases.
    if args.as_module and args.module:
        parser.error("use either --as-module or -m, not both")

    module_name = args.as_module or args.module

    compiler = find_compiler()

    # Create a secure temporary workspace for intermediate C++ code.
    tmp_file = tempfile.NamedTemporaryFile(
        mode="w",
        suffix=".cpp",
        prefix="abct_",
        delete=False,
    )
    tmp_cpp = Path(tmp_file.name)
    tmp_file.close()

    try:
        # Step 1: Lower AbcT source to C++.
        cpp_args = [
            str(input_file),
            "-o",
            str(tmp_cpp),
        ]

        if module_name:
            cpp_args.extend(["-m", module_name])

        abcTCpp(cpp_args)

        # Module mode: return the generated C++ module directly.
        if module_name:
            shutil.copyfile(tmp_cpp, args.output)
            print(f"Successfully generated module -> {args.output}")
            return

        # Step 2: Get AbcT include flags.
        include_flag = abct_config()

        # Step 3: Compile the generated C++.
        compile_command = [
            compiler,
            include_flag,
            "-std=c++20",
            str(tmp_cpp),
            "-o",
            args.output,
        ]

        if args.extra_compile_args:
            compile_command.extend(args.extra_compile_args.split())

        run_command(compile_command)

        print(f"Successfully built ({compiler}) -> {args.output}")

    finally:
        try:
            tmp_cpp.unlink()
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    main()
