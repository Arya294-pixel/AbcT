# semantics/traits.py
from ..abct_ast.node import (
    TemplateCapablity, ClassDef, Assign, Const, Name
)

class TraitError(RuntimeError): pass

class TraitAnalyser:
    def __init__(self, cls:ClassDef):
        self.name = cls.name.id
        self.traits = self.get_traits(cls)
    @staticmethod
    def get_traits(node: ClassDef) -> list[TemplateCapablity]:
        # Iterate over public_attributes (which are AnnAssigns) 
        # Wait: Are your __trait__ assignments in public_attributes or separate?
        # If __trait__ is an Assign (not AnnAssign), make sure it's in your list.
        
        for attr in node.public_attributes:
            # Check if this attribute is an Assign node
            if not isinstance(attr, AnnAssign):
                continue
                # attr.target is a Name node (per your node.py)
                if not isinstance(attr.target, Name) and attr.target.id == "__trait__":
                    continue
                    # attr.value is a Const node
                if isinstance(attr.value, Const):
                    if attr.annotation != "CompileTimeConst":
                        raise TraitError("__trait__ should have the type CompileTimeConst")
                    return TraitAnalyser.parse_trait(attr.value.value)
                    
        return [TemplateCapablity.UNKNOWN]

    @staticmethod
    def parse_trait(trait_str: str) -> list[TemplateCapablity]:
        """
        Parses a string like "['INTEGER', 'COPYABLE']" into a list of Enums.
        """
        # 1. Clean the input string
        s = trait_str.strip().replace(" ", "").replace("'", '"')
        
        # 2. Basic Validation
        if not (s.startswith("[") and s.endswith("]")):
            raise TraitError(f"Trait declaration must be in format '[...]', got: {trait_str}")
        
        # 3. Extract items
        content = s[1:-1]
        if not content:
            return [TemplateCapablity.UNKNOWN]
        
        traits = set()
        items = content.split(",")
        
        for item in items:
            # Remove quotes and normalize to uppercase
            clean_item = item.replace('"', '').upper()
            
            # Lookup in Enum (defaults to UNKNOWN if not found)
            capability = getattr(TemplateCapablity, clean_item, TemplateCapablity.UNKNOWN)
            traits.add(capability)
            
        return list(sorted(traits, key=lambda x: x.value)) if traits else [TemplateCapablity.UNKNOWN]
