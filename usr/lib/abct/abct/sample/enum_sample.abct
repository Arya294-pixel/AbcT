# ========================================
# Basic enum
# ========================================

enum Color {
    RED,
    GREEN,
    BLUE
}

# ========================================
# Trailing comma
# ========================================

enum Direction {
    NORTH,
    SOUTH,
    EAST,
    WEST,
}

# ========================================
# Explicit values
# ========================================

enum Number {
    ONE = 1,
    TWO = 2,
    THREE = 3
}

# ========================================
# Mixed implicit and explicit values
# ========================================

enum Status {
    UNKNOWN,
    OK = 5,
    ERROR,
    FATAL = 100,
    LAST
}

# ========================================
# Explicit underlying type
# ========================================

enum SmallNumber: u8 {
    ZERO = 0,
    ONE = 1,
    TWO
}

# ========================================
# Pointer type
# ========================================

enum Name: const char* {
    ARYA = "Arya",
    BOB = "Bob",
}

# ========================================
# Expressions as values
# ========================================

enum Math {
    A = 1 + 2,
    B = 10 * 2,
    C = 100 / 5
}
