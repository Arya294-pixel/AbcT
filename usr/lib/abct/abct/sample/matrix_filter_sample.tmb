fn main() -> int {
    # A 3x3 sensor grid representing data points
    grid: int[][] = [
        [45, 89, 12],
        [73, 34, 95],
        [18, 62, 50]
    ];
    
    print("--- Original Sensor Grid ---");
    print(grid);

    # We want to flag items higher than a threshold (e.g., 60)
    print("--- Flagged High-Value Coordinates ---");
    
    r: int;
    r = 0;
    while r < 3 {
        c: int;
        c = 0;
        while c < 3 {
            val: int;
            val = grid[r][c];
            
            # Using your existing if-else condition logic
            if val > 60 {
                print("Alert at coordinate:");
                print(r);
                print(c);
                print("Value:");
                print(val);
            }
            
            c = c + 1;
        }
        r = r + 1;
    }

    return 0;
}
