fn main() -> int {
    # 1. Setup a data matrix for testing mutations
    matrix: int[][] = [[10, 20], [30, 40], [50, 60]];
    
    # 2. While Loop: Classic index-based mutation
    print("--- Running Matrix Scale (While Loop) ---");
    row: int;
    row = 0;
    while row < 3 {
        col: int;
        col = 0;
        while col < 2 {
            # Double every value in the matrix
            matrix[row][col] = matrix[row][col] + 5;
            col = col + 1;
        }
        row = row + 1;
    }
    print(matrix); # Expected output: [[20, 40], [60, 80], [100, 120]]

    # 3. Conditional Breaks: Tracking a threshold accumulation loop
    print("--- Running Accumulator Target Check ---");
    sum: int;
    sum = 0;
    i: int;
    i = 0;
    
    # Loop that processes elements with a conditional exit condition
    while i < 3 {
        current_val: int;
        current_val = matrix[i][0];
        
        if sum + current_val < 150 {
            sum = sum + current_val;
            print(sum);
        }
        i = i + 1;
    }
    
    return 0;
}
